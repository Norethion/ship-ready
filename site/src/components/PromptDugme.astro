---
// Prompt'u panoya kopyalayan düğme. Ne yaptığı adında ve simgesinde yazar; üzerine gelince prompt'un kendisi görünür.
// tur="kod" canlı örneğin HTML kodunu kopyalar; ipucunda kod yerine ne kopyalanacağı yazar. ana, kartın asıl eylemini dolu düğme yapar;
// simge, etiketi sadece ekran okuyucuya bırakıp düğmeyi simgeye indirir (dar alt şeritler için).
import { Icon } from '@astrojs/starlight/components';

interface Props {
	metin: string;
	etiket: string;
	tur?: 'denetim' | 'kurulum' | 'claude' | 'codex' | 'uygulama' | 'kullanim' | 'tasarim' | 'kod';
	ana?: boolean;
	simge?: boolean;
}
const { metin, etiket, tur = 'kullanim', ana = false, simge = false } = Astro.props;
const SIMGE = {
	denetim: 'approve-check-circle',
	kurulum: 'download',
	claude: 'puzzle',
	codex: 'forward-slash',
	uygulama: 'desktop',
	kullanim: 'setting',
	tasarim: 'pencil',
	kod: 'document',
} as const;
const ipucu =
	tur === 'kod'
		? 'Örneğin tek dosyalık HTML kodunu (CSS ve JavaScript içinde) kopyalar'
		: `Kopyalanacak prompt:\n\n${metin.length > 500 ? metin.slice(0, 500) + '…' : metin}`;
---

<button type="button" class={`prompt-dugme t-${tur}${ana ? ' ana' : ''}${simge ? ' simge' : ''}`} data-kopya={metin} title={simge ? `${etiket}: ${ipucu}` : ipucu}>
	<Icon name={SIMGE[tur]} size="1em" />
	<span>{etiket}</span>
</button>

<script>
	// Sayfadaki bütün prompt düğmeleri için tek dinleyici; kopyalanınca etiket kısa süre "Kopyalandı" olur.
	document.addEventListener('click', async (e) => {
		const b = (e.target as HTMLElement).closest<HTMLButtonElement>('button[data-kopya]');
		if (!b) return;
		const span = b.querySelector('span');
		const eski = span?.textContent ?? '';
		const metin = b.dataset.kopya ?? '';
		let tamam = false;
		try {
			await navigator.clipboard.writeText(metin);
			tamam = true;
		} catch {
			// Pano izni yoksa (ör. sayfa dosyadan açıldıysa) gizli bir metin alanından kopyalanır.
			const t = document.createElement('textarea');
			t.value = metin;
			document.body.append(t);
			t.select();
			tamam = document.execCommand('copy');
			t.remove();
		}
		if (span) span.textContent = tamam ? 'Kopyalandı' : 'Kopyalanamadı';
		if (tamam) b.classList.add('kopyalandi');
		setTimeout(() => {
			if (span) span.textContent = eski;
			b.classList.remove('kopyalandi');
		}, 1600);
	});
</script>
