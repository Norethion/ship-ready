---
// Starlight'ın kenar menüsü yerine eski sayfadaki panel: her bağlantının simgesi, büyük harfli soluk grup başlıkları,
// sağda sayaç rozeti. Menünün kendisi src/data/sidebar.json'dadır (uygulama/site_uret.py üretir);
// simge bağlantının data-ikon özelliğinden, sayaç badge'den gelir.
import MobileMenuFooter from 'virtual:starlight/components/MobileMenuFooter';
import SidebarPersister from '@astrojs/starlight/components/SidebarPersister.astro';
import Simge from './Simge.astro';

const { sidebar } = Astro.locals.starlightRoute;
type Baglanti = Extract<(typeof sidebar)[number], { type: 'link' }>;
// Alt sayfalarda da (ör. tek rapor) üstteki bağlantı seçili görünür.
const secili = (e: Baglanti) => e.isCurrent || (e.href.length > 1 && Astro.url.pathname.startsWith(e.href));
// Tek başına duran bağlantı (Genel bakış) başlıksız bir blok olur; gruplar başlıklı blok.
const bloklar = sidebar.map((g) =>
	g.type === 'link'
		? { baslik: '', ogeler: [g] }
		: { baslik: g.label, ogeler: g.entries.filter((e): e is Baglanti => e.type === 'link') },
);
---

<SidebarPersister>
	<div class="kenar-menu">
		{
			bloklar.map((b) => (
				<div class:list={['km-blok', { 'km-grup': b.baslik }]}>
					{b.baslik && <span class="km-baslik">{b.baslik}</span>}
					<ul>
						{b.ogeler.map((e) => (
							<li>
								<a href={e.href} class="km-oge" aria-current={secili(e) ? 'page' : undefined}>
									<Simge ad={String(e.attrs['data-ikon'] ?? 'file')} />
									<span class="km-ad">{e.label}</span>
									{e.badge && <span class="km-sayac">{e.badge.text}</span>}
								</a>
							</li>
						))}
					</ul>
				</div>
			))
		}
	</div>
</SidebarPersister>

<div class="md:sl-hidden">
	<MobileMenuFooter />
</div>
