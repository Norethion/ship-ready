---
import katalog from '../data/katalog.json';
import RepoKart from './RepoKart.astro';
import Simge from './Simge.astro';
import { katla } from '../arama';
import { dikkat, kategoriAdi, kurulum, plainInline } from '../repo';

const repolar = katalog.repolar;
const say = (f: (r: typeof repolar[number]) => boolean) => repolar.filter(f).length;
const simgeler: Record<string, string> = { 'ajan-skill': 'layers', 'ajan-erisim': 'globe', 'ajan-yonetim': 'sparkles', tasarim: 'palette', kalite: 'shield', yayin: 'server', icerik: 'megaphone', medya: 'play', ogrenme: 'book', gunluk: 'package' };
---
<div class="repo-catalog not-content">
	<header class="repo-catalog-hero"><p class="repo-eyebrow">{repolar.length} repo · {katalog.klasorler.length} kategori</p><h1>Repo kataloğu</h1><p>Ajanına, projene ya da bilgisayarına kurabileceğin GitHub repoları. Her birinin kendi sayfasında hazır kurulum prompt’u var.</p></header>
	<div class="repo-toolbar"><label class="repo-search"><Simge ad="search" boyut={18} /><input type="search" id="repo-search" placeholder="Repo adı, sahip ya da açıklama ara" aria-label="Repolarda ara" /></label><label class="repo-sort">Sırala <select aria-label="Repoları sırala"><option value="at">Yeni eklenen</option><option value="s">Yıldız</option><option value="ad">Ad</option></select></label></div>
	<div class="repo-chip-row" role="group" aria-label="Kategori"><button type="button" class="repo-chip selected" data-category="*" aria-pressed="true">Tümü <span>{repolar.length}</span></button><button type="button" class="repo-chip warning" data-category="!" aria-pressed="false"><Simge ad="alert" boyut={15} /> Dikkat <span>{say(dikkat)}</span></button>{katalog.klasorler.map((f) => <button type="button" class="repo-chip" data-category={f.id} aria-pressed="false"><Simge ad={simgeler[f.id]} boyut={15} /> {kategoriAdi(f.kisa)} <span>{say((r) => r.klasor === f.id)}</span></button>)}</div>
	{katalog.klasorler.map((f) => <div class="repo-chip-row repo-subcategories" role="group" aria-label={`${kategoriAdi(f.ad)} alt kategorileri`} data-sub-for={f.id} hidden><button type="button" class="repo-chip selected" data-sub="*" aria-pressed="true">Tümü</button>{f.alt.map((a) => <button type="button" class="repo-chip" data-sub={a.id} aria-pressed="false">{a.ad} <span>{say((r) => r.klasor === f.id && r.alt_klasor === a.id)}</span></button>)}</div>)}
	<div class="repo-chip-row repo-install" role="group" aria-label="Kurulum yeri"><span class="repo-row-label">Kurulum yeri</span><button type="button" class="repo-chip selected" data-install="*" aria-pressed="true">Tümü</button>{(Object.keys(kurulum) as (keyof typeof kurulum)[]).map((k) => <button type="button" class="repo-chip" data-install={k} aria-pressed="false">{kurulum[k].etiket} <span>{say((r) => r.kurulum.includes(k))}</span></button>)}</div>
	<div class="repo-results-head"><p class="repo-result-count" aria-live="polite">{repolar.length} / {repolar.length} repo</p><button type="button" class="repo-clear" hidden>Süzgeçleri temizle</button></div>
	<div class="repo-grid">{repolar.map((r) => <div class="repo-grid-item" data-category={r.klasor} data-sub={r.alt_klasor} data-install={r.kurulum.join(' ')} data-warning={dikkat(r) ? '1' : ''} data-search={katla(plainInline([r.repo, r.aciklama, r.uyari, r.kaynak?.ad, r.kategori, r.alt_kategori, ...r.kurulum.map((k) => kurulum[k as keyof typeof kurulum].etiket)].join(' ')))} data-at={r.eklenme || ''} data-stars={r.yildiz || 0} data-name={r.repo.toLowerCase()}><RepoKart repo={r} /></div>)}</div>
	<div class="repo-empty" hidden><Simge ad="search" boyut={28} /><h2>Sonuç yok</h2><p>Aramanı kontrol et, daha kısa bir kelime dene ya da kategori ve kurulum yeri seçimlerini kaldır.</p><button type="button" class="repo-clear">Süzgeçleri temizle</button></div>
</div>
<script>
	import { eslesme, terimler } from '../arama';
	const root = document.querySelector<HTMLElement>('.repo-catalog');
	if (root) {
		const cards = [...root.querySelectorAll<HTMLElement>('.repo-grid-item')];
		const grid = root.querySelector<HTMLElement>('.repo-grid')!;
		const search = root.querySelector<HTMLInputElement>('#repo-search')!;
		const sort = root.querySelector<HTMLSelectElement>('.repo-sort select')!;
		let category = '*', sub = '*', install = '*';
		const select = (button: HTMLButtonElement, attr: string) => {
			button.closest('[role="group"]')?.querySelectorAll<HTMLButtonElement>(`button[data-${attr}]`).forEach((b) => { b.classList.toggle('selected', b === button); b.setAttribute('aria-pressed', String(b === button)); });
		};
		const apply = () => {
			const terms = terimler(search.value);
			let count = 0;
			cards.forEach((card) => { const d = card.dataset; card.hidden = !((category === '*' || (category === '!' ? d.warning === '1' : d.category === category)) && (sub === '*' || d.sub === sub) && (install === '*' || d.install!.split(' ').includes(install)) && terms.every((t) => eslesme(t, d.search!) > 0)); if (!card.hidden) count++; });
			cards.sort((a, b) => sort.value === 's' ? +b.dataset.stars! - +a.dataset.stars! : sort.value === 'ad' ? a.dataset.name!.localeCompare(b.dataset.name!) : b.dataset.at!.localeCompare(a.dataset.at!) || +b.dataset.stars! - +a.dataset.stars!).forEach((card) => grid.append(card));
			root.querySelector<HTMLElement>('.repo-result-count')!.textContent = `${count} / ${cards.length} repo`;
			root.querySelector<HTMLElement>('.repo-empty')!.hidden = count > 0;
			root.querySelector<HTMLElement>('.repo-results-head .repo-clear')!.hidden = category === '*' && install === '*' && !search.value;
		};
		root.addEventListener('click', (e) => {
			const target = e.target as HTMLElement;
			if (target.closest('.repo-clear')) { category = sub = install = '*'; search.value = ''; root.querySelector<HTMLButtonElement>('[data-category="*"]')?.click(); root.querySelector<HTMLButtonElement>('[data-install="*"]')?.click(); history.replaceState(null, '', location.pathname); apply(); return; }
			const button = target.closest<HTMLButtonElement>('button[data-category],button[data-sub],button[data-install]');
			if (!button) return;
			if (button.dataset.category !== undefined) { category = button.dataset.category; sub = '*'; select(button, 'category'); root.querySelectorAll<HTMLElement>('.repo-subcategories').forEach((row) => { row.hidden = row.dataset.subFor !== category; row.querySelector<HTMLButtonElement>('[data-sub="*"]')?.click(); }); }
			else if (button.dataset.sub !== undefined) { sub = button.dataset.sub; select(button, 'sub'); }
			else { install = button.dataset.install!; select(button, 'install'); }
			apply();
		});
		search.addEventListener('input', apply); sort.addEventListener('change', apply);
		const hash = () => { const value = location.hash.slice(1); if (value === 'dikkat') root.querySelector<HTMLButtonElement>('[data-category="!"]')?.click(); else if (value.startsWith('ara=')) { search.value = decodeURIComponent(value.slice(4)); apply(); } else if (value.startsWith('kategori=')) { const [cat, child] = value.slice(9).split('/'); root.querySelector<HTMLButtonElement>(`[data-category="${CSS.escape(cat)}"]`)?.click(); if (child) root.querySelector<HTMLElement>(`[data-sub-for="${CSS.escape(cat)}"]`)?.querySelector<HTMLButtonElement>(`[data-sub="${CSS.escape(child)}"]`)?.click(); } };
		window.addEventListener('hashchange', hash); hash(); apply();
	}
</script>
